# Public URL of this app, e.g. https://spotify-am-sync.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Generate a random 32+ byte secret for signing the session cookie.
APP_SESSION_SECRET=replace-with-a-long-random-secret

# Spotify developer app
SPOTIFY_CLIENT_ID=replace-me
SPOTIFY_CLIENT_SECRET=replace-me

# Apple Music developer credentials
APPLE_TEAM_ID=replace-me
MUSIC_KIT_KEY_ID=replace-me
APPLE_PRIVATE_KEY_BASE64=replace-me
